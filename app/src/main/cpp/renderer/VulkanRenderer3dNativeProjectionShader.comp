#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D sourceImage;
layout(std430, binding = 1) writeonly buffer NativeProjectionBuffer
{
    uint nativeProjection[];
};

layout(push_constant) uniform PushConstants
{
    uint sourceWidth;
    uint sourceHeight;
} pc;

uint packColor6A5(vec4 color)
{
    vec4 clamped = clamp(color, vec4(0.0), vec4(1.0));
    uint r8 = uint(clamped.r * 255.0 + 0.5);
    uint g8 = uint(clamped.g * 255.0 + 0.5);
    uint b8 = uint(clamped.b * 255.0 + 0.5);
    uint a8 = uint(clamped.a * 255.0 + 0.5);
    return (r8 >> 2u)
        | ((g8 >> 2u) << 8u)
        | ((b8 >> 2u) << 16u)
        | ((a8 >> 3u) << 24u);
}

void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= 256u || gid.y >= 192u)
        return;

    if (pc.sourceWidth == 0u || pc.sourceHeight == 0u
        || (pc.sourceWidth % 256u) != 0u
        || (pc.sourceHeight % 192u) != 0u)
        return;
    uint scaleX = pc.sourceWidth / 256u;
    uint scaleY = pc.sourceHeight / 192u;
    if (scaleX == 0u || scaleX != scaleY)
        return;

    uint sourceX = gid.x * scaleX + scaleX / 2u;
    uint sourceY = gid.y * scaleY + scaleY / 2u;
    nativeProjection[gid.y * 256u + gid.x] =
        packColor6A5(texelFetch(sourceImage, ivec2(sourceX, sourceY), 0));
}
